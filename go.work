go 1.27

use (
	./kernel
	./libs/m
	./libs/meshfile
	./plugins/canvas
	./plugins/ecs
	./plugins/gfx
	./plugins/gogpu
	./plugins/metronome
	./plugins/mux
	./plugins/platform
	./plugins/render
	./submodules/gogpu
	./submodules/wgpu
)

// The modules others require at v0.0.0 are replaced by their directories as
// well as used: once a module from outside the workspace is in the build,
// Go reads the requirement graph, and fetches a used module's v0.0.0
// otherwise.
replace (
	github.com/dvoyni/cog/kernel v0.0.0 => ./kernel
	github.com/dvoyni/cog/libs/m v0.0.0 => ./libs/m
	github.com/dvoyni/cog/libs/meshfile v0.0.0 => ./libs/meshfile
	github.com/dvoyni/cog/plugins/gfx v0.0.0 => ./plugins/gfx
	github.com/dvoyni/cog/plugins/gogpu v0.0.0 => ./plugins/gogpu
	github.com/dvoyni/cog/plugins/metronome v0.0.0 => ./plugins/metronome
	github.com/dvoyni/cog/plugins/platform v0.0.0 => ./plugins/platform
	github.com/dvoyni/cog/plugins/render v0.0.0 => ./plugins/render
	github.com/gogpu/gogpu v0.0.0 => ./submodules/gogpu
)
